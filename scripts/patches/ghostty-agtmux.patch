+test "embedded App.performAction forwards custom osc through action callback" {
+    const testing = std.testing;
+
+    const Capture = struct {
+        called: bool = false,
+        target_key: ?apprt.Target.Key = null,
+        surface: ?*apprt.Surface = null,
+        action_key: ?apprt.Action.Key = null,
+        osc: ?u16 = null,
+        payload: ?[]const u8 = null,
+    };
+
+    const Callbacks = struct {
+        fn wakeup(_: ?*anyopaque) callconv(.c) void {}
+
+        fn action(
+            app: *App,
+            target: apprt.Target.C,
+            action_: apprt.Action.C,
+        ) callconv(.c) bool {
+            const capture: *Capture = @ptrCast(@alignCast(app.opts.userdata.?));
+            capture.called = true;
+            capture.target_key = target.key;
+            capture.surface = switch (target.key) {
+                .app => null,
+                .surface => target.value.surface,
+            };
+            capture.action_key = action_.key;
+            capture.osc = action_.value.custom_osc.osc;
+            capture.payload = action_.value.custom_osc.payload[0..action_.value.custom_osc.len];
+            return true;
+        }
+
+        fn readClipboard(
+            _: ?*anyopaque,
+            _: c_int,
+            _: *apprt.ClipboardRequest,
+        ) callconv(.c) void {}
+
+        fn confirmReadClipboard(
+            _: ?*anyopaque,
+            _: [*:0]const u8,
+            _: *apprt.ClipboardRequest,
+            _: apprt.ClipboardRequestType,
+        ) callconv(.c) void {}
+
+        fn writeClipboard(
+            _: ?*anyopaque,
+            _: [*:0]const u8,
+            _: c_int,
+            _: bool,
+        ) callconv(.c) void {}
+    };
+
+    var capture = Capture{};
+    var core_app: CoreApp = undefined;
+    var runtime_surface: apprt.Surface = undefined;
+    var core_surface: CoreSurface = undefined;
+    core_surface.rt_surface = &runtime_surface;
+
+    var app: App = undefined;
+    app.core_app = &core_app;
+    app.opts = .{
+        .userdata = &capture,
+        .supports_selection_clipboard = false,
+        .wakeup = &Callbacks.wakeup,
+        .action = &Callbacks.action,
+        .read_clipboard = &Callbacks.readClipboard,
+        .confirm_read_clipboard = &Callbacks.confirmReadClipboard,
+        .write_clipboard = &Callbacks.writeClipboard,
+    };
+    app.keymap = undefined;
+    app.config = undefined;
+
+    const payload = "agtmux;v=1;kind=file;path=/tmp/spec.md";
+    const handled = try app.performAction(
+        .{ .surface = &core_surface },
+        .custom_osc,
+        .{
+            .osc = terminal.osc.AGTMUX_BRIDGE_OSC,
+            .payload = payload,
+        },
+    );
+
+    try testing.expect(handled);
+    try testing.expect(capture.called);
+    try testing.expectEqual(apprt.Target.Key.surface, capture.target_key);
+    try testing.expectEqual(&runtime_surface, capture.surface);
+    try testing.expectEqual(apprt.Action.Key.custom_osc, capture.action_key);
+    try testing.expectEqual(terminal.osc.AGTMUX_BRIDGE_OSC, capture.osc);
+    try testing.expectEqualSlices(u8, payload, capture.payload.?);
+}
