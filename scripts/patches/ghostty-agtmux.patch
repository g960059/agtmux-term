+        fn shouldRebuildViewportShiftRow(
+            self: *Self,
+            y: terminal.size.CellCountInt,
+            viewport_row_shift: i32,
+            mouse: renderer.State.Mouse,
+            shift_extra_row: ?terminal.size.CellCountInt,
+        ) bool {
+            if (viewport_row_shift == 0 or self.cells.size.rows == 0) return false;
+
+            const rows = self.cells.size.rows;
+            const abs_shift: terminal.size.CellCountInt = @intCast(@abs(viewport_row_shift));
+
+            if (shift_extra_row) |extra_row| {
+                if (y == extra_row) return true;
+            }
+
+            if (viewport_row_shift > 0) {
+                if (y < abs_shift) return true;
+                if (y == rows - 1) return true;
+            } else {
+                if (y >= rows - abs_shift) return true;
+                if (y == 0) return true;
+            }
+
+            const mouse_pt = mouse.point orelse return false;
+            if (mouse_pt.y >= @as(u32, @intCast(rows))) return false;
+
+            const mouse_y: terminal.size.CellCountInt = @intCast(mouse_pt.y);
+            if (y == mouse_y) return true;
+
+            const previous_mouse_y = @as(i32, @intCast(mouse_y)) + viewport_row_shift;
+            if (previous_mouse_y < 0 or previous_mouse_y >= @as(i32, @intCast(rows))) return false;
+
+            return y == @as(terminal.size.CellCountInt, @intCast(previous_mouse_y));
+        }
