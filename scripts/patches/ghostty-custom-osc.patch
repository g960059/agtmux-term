+test "stream: custom osc 9911 reaches handler with ST terminator" {
+    const H = struct {
+        const Self = @This();
+        payload: ?osc.Command.CustomOSC = null,
+
+        pub fn vt(
+            self: *Self,
+            comptime action: streampkg.Action.Tag,
+            value: streampkg.Action.Value(action),
+        ) !void {
+            switch (action) {
+                .custom_osc => self.payload = value,
+                else => {},
+            }
+        }
+    };
+
+    var s: Stream(H) = .init(.{});
+    try s.nextSlice("\x1b]9911;agtmux;open=/tmp/demo.md\x1b\\");
+
+    const payload = s.handler.payload orelse return error.TestUnexpectedResult;
+    try testing.expectEqual(osc.AGTMUX_BRIDGE_OSC, payload.osc);
+    try testing.expectEqualSlices(u8, "agtmux;open=/tmp/demo.md", payload.payload);
+}
